rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function room(code) { return get(/databases/$(database)/documents/rooms/$(code)).data; }

    // Your profile and quiz: only you
    match /users/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /reviews/{userId} {
      allow read: if true;
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasAll(['authorId', 'name', 'rating', 'comment', 'createdAt'])
        && request.resource.data.keys().hasOnly(['authorId', 'name', 'rating', 'comment', 'createdAt'])
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.name == get(/databases/$(database)/documents/users/$(userId)).data.f
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.comment is string
        && request.resource.data.comment.size() > 0
        && request.resource.data.comment.size() <= 300
        && request.resource.data.createdAt == request.time;
    }

    match /rooms/{code} {
      // anyone signed in can look up ONE room by its code (needed to join), but can only list rooms they belong to
      allow get: if signedIn();
      allow list: if signedIn() && request.auth.uid in resource.data.memberIds;
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid]
        && request.resource.data.drawn == false;
      // the host can edit the room; others can only add themselves (before the draw)
      allow update: if signedIn() && (
        resource.data.ownerId == request.auth.uid
        || (!resource.data.drawn
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds'])
            && request.auth.uid in request.resource.data.memberIds
            && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1));

      // names shown in the lobby: members only
      match /members/{userId} {
        allow read: if signedIn() && request.auth.uid in room(code).memberIds;
        allow write: if signedIn() && request.auth.uid == userId && userId in room(code).memberIds;
      }
      // quiz copies: readable only by the owner (who draws) and by yourself
      match /quizzes/{userId} {
        allow read: if signedIn() && (request.auth.uid == userId || room(code).ownerId == request.auth.uid);
        allow write: if signedIn() && request.auth.uid == userId && userId in room(code).memberIds;
      }
      // who you buy for: only YOU can read your own match; written once by the host
      match /matches/{giver} {
        allow read: if signedIn() && request.auth.uid == giver;
        allow write: if signedIn() && room(code).ownerId == request.auth.uid && !room(code).drawn;
      }
    }
  }
}
